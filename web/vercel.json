{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)\.(js|wasm|mjs|png|json|otf|ttf)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/(index.html|flutter_service_worker.js|version.json)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
